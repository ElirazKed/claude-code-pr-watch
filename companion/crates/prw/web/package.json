{
  "name": "prw-web",
  "private": true,
  "version": "0.0.0",
  "description": "prw web's page: built into web/dist, which the prw binary embeds",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
